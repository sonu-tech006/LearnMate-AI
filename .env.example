# LearnMate AI - Environment Configuration

# MongoDB Atlas Connection URI
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/learnmate?retryWrites=true&w=majority
MONGODB_URI=""

# Secret key for JWT authentication signing (keep secure in production)
JWT_SECRET="learnmate_jwt_super_secure_secret_key_change_in_production_2026"

# Google Gemini API Key (Server-side AI features)
# Automatically provided in AI Studio or obtained from Google AI Studio
GEMINI_API_KEY=""

# Base URL of the client application (for CORS and links)
CLIENT_URL="http://localhost:3000"

# Optional port (defaults to 3000 if omitted)
PORT=3000
